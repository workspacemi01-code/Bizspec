# Copy to .env.local and fill in. .env* is gitignored — no real value is ever
# committed, and nothing here belongs in a NEXT_PUBLIC_ variable except the
# values that are already public on the page.

# --- Enquiry delivery (server-only; never exposed to the browser) ----------
# From https://resend.com → API Keys. Without it the form validates but does
# not deliver.
RESEND_API_KEY=

# Where enquiries land. Defaults to the address in lib/content.ts.
CONTACT_TO=bizspec.org@gmail.com

# Resend's shared sender works immediately but only delivers to the address
# that owns the Resend account. Once a domain is verified in Resend, change
# this to something like "Bizspec <website@bizspec.com>".
CONTACT_FROM=Bizspec Website <onboarding@resend.dev>

# --- Public site values ---------------------------------------------------
# The live domain. Canonical URLs and the social card point here.
NEXT_PUBLIC_SITE_URL=https://bizspec.co
NEXT_PUBLIC_CONTACT_EMAIL=bizspec.org@gmail.com
NEXT_PUBLIC_PHONE=+234 703 559 9433
NEXT_PUBLIC_WHATSAPP=2347035599433
NEXT_PUBLIC_LINKEDIN=

# Google Analytics 4 measurement id. Leave empty and no analytics script is
# ever loaded, consent or not.
NEXT_PUBLIC_GA_ID=
